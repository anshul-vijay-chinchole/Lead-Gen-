# =============================================================================
#  leadgen - API keys and settings
# =============================================================================
#  Copy this file to .env (same folder you run `leadgen` from) and fill in
#  only what your playbook uses. `leadgen validate -p <playbook>` tells you
#  exactly which ones are missing. The offline demo needs none of them.
#
#  Format: NAME=value   (no spaces around "=", quotes optional, # starts a comment)
#  Variables already set in your shell always win over this file.
#  NEVER commit your real .env file - it contains secrets.
# =============================================================================

# --- You (used in every email via ${SENDER_NAME} etc. in the playbooks) ------------
SENDER_NAME=Your Name
SENDER_TITLE=Founder
SENDER_COMPANY=Your Company
SENDER_WEBSITE=https://your-company.example
BOOKING_LINK=                       # Calendly / Cal.com link for interested replies

# --- Sources: where companies + buying signals come from ----------------------------
THEIRSTACK_API_KEY=                 # theirstack source: job postings with company data
ADZUNA_APP_ID=                      # adzuna source: job postings (needs the ID ...
ADZUNA_APP_KEY=                     #   ... and the key, both from developer.adzuna.com)
APOLLO_API_KEY=                     # apollo source (company search, funding) AND apollo finder (people + emails)
APIFY_TOKEN=                        # apify source: any Apify scraper (e.g. Google Maps)
# greenhouse / lever / ashby / csv / json sources need no key.

# --- Finding people + emails -----------------------------------------------------------
HUNTER_API_KEY=                     # hunter finder (domain search, email finder) and hunter verifier
# APOLLO_API_KEY above also powers the apollo finder; csv + pattern finders need no key.

# --- Email verification (pick one verifier in the playbook) ----------------------------
MILLIONVERIFIER_API_KEY=            # millionverifier verifier
ZEROBOUNCE_API_KEY=                 # zerobounce verifier
NEVERBOUNCE_API_KEY=                # neverbounce verifier
# The basic verifier is free and offline (syntax + disposable domains only).

# --- AI writing + AI reply classification (writer.type: ai) ----------------------------
ANTHROPIC_API_KEY=                  # writer.provider: anthropic
OPENAI_API_KEY=                     # writer.provider: openai (only ever sent to api.openai.com)
# For writer.provider: openai_compatible (OpenRouter, Groq, a local server, ...) set
# writer.api_key_env in the playbook to the name of the variable holding that key, e.g.:
# OPENROUTER_API_KEY=

# --- Sending tools ----------------------------------------------------------------------
INSTANTLY_API_KEY=                  # instantly exporter (push leads into a campaign)
INSTANTLY_CAMPAIGN_ID=              # used as ${INSTANTLY_CAMPAIGN_ID} in the playbooks
SMARTLEAD_API_KEY=                  # smartlead exporter
SMARTLEAD_CAMPAIGN_ID=              # used as ${SMARTLEAD_CAMPAIGN_ID} in the playbooks
# instantly_csv / smartlead_csv / csv / json exporters just write files - no key.

# --- Google Sheets exporter (pip install gspread) ---------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=     # path to a service-account JSON file ...
GOOGLE_SERVICE_ACCOUNT_JSON=        # ... or the JSON itself on one line
# Share the sheet with the service account's email address.

# --- Other outputs + alerts -------------------------------------------------------------
LEADGEN_EXPORT_WEBHOOK_URL=         # webhook exporter: POST finished leads to Zapier / Make / n8n / a CRM
SLACK_WEBHOOK_URL=                  # slack notifier: Slack "incoming webhook" URL for alerts
LEADGEN_WEBHOOK_URL=                # webhook notifier: POST alerts (positive replies, run summaries) anywhere

# --- Reply webhook server (leadgen serve) -----------------------------------------------
LEADGEN_WEBHOOK_TOKEN=              # shared secret; Instantly/Smartlead call .../webhook?token=<this>
