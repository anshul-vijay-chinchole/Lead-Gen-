# =============================================================================
#  leadgen - API keys and settings
# =============================================================================
#  Copy this file to .env (in the folder you run `leadgen` from) and fill in
#  only what you use. What you need depends on what you run:
#
#    * The offline demo (leadgen deliver --client demo-client): NOTHING.
#    * The default live delivery playbook (playbooks/recruitment-delivery.yaml,
#      the base of every new client file): only ADZUNA_APP_ID + ADZUNA_APP_KEY
#      (a FREE key from developer.adzuna.com), plus your SENDER_* details for
#      the report footer.
#    * Everything else is optional: paid data / email-checking tools you switch
#      on later, AI opening lines, the Google Sheets push, alerts, and the
#      outbound-mode tools at the bottom (sending tools, reply webhook).
#
#  Check your keys:  leadgen doctor --client <name>   (or -p <playbook>)
#    one FREE call per key (never a paid lookup); --dry-run only checks they are set.
#  Offline checklist: leadgen validate -p <playbook>
#
#  Format: NAME=value   (no spaces around "=", quotes optional, # starts a comment)
#  Leave a line empty (NAME=) when you don't use it - don't paste a dummy value,
#  or the engine will try to use it as a real key.
#  Variables already set in your shell always win over this file. Another file
#  can be used with --env-file PATH.
#  NEVER commit your real .env file - it contains secrets. The engine masks keys
#  and tokens in its logs and error messages, but the file itself is plain text.
# =============================================================================

# --- You: shown in the footer of every Hiring Signal Report ----------------------------
# (read as ${SENDER_NAME} etc. by the delivery playbooks' "delivery:" section; a
#  client file can override them under "branding:")
SENDER_NAME=Your Name
SENDER_EMAIL=                       # e.g. you@your-company.example - clients can reply to you
SENDER_WEBSITE=                     # e.g. https://your-company.example

# --- Job postings: where the hiring signals come from -----------------------------------
# DEFAULT live delivery path - free key from developer.adzuna.com (both values needed):
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional, PAID (switched off in the shipped delivery playbooks):
THEIRSTACK_API_KEY=                 # theirstack source: job postings with company data + hiring teams
APOLLO_API_KEY=                     # apollo source (company search, funding) AND apollo finder (people + emails)
APIFY_TOKEN=                        # apify / linkedin_jobs sources. The LinkedIn / Indeed scrapers are
                                    #   "use at own risk" (against those sites' terms) and never used by default.
# greenhouse / lever / ashby job boards and csv / json files need no key.

# --- Naming the decision-maker + finding emails (optional) ------------------------------
HUNTER_API_KEY=                     # hunter finder (people + emails at a domain) and hunter verifier; small free plan, then paid
# APOLLO_API_KEY above also powers the apollo finder. The csv finder (your own
# contact list) and the pattern finder (free email guesses) need no key.

# --- Email checking (optional, PAID; pick one verifier in the playbook) -----------------
# The free "basic" checker needs no key but can never mark an email "verified".
MILLIONVERIFIER_API_KEY=            # millionverifier verifier (also reports credits left)
ZEROBOUNCE_API_KEY=                 # zerobounce verifier
NEVERBOUNCE_API_KEY=                # neverbounce verifier

# --- AI (optional, PAID; used whenever writer.provider is set) --------------------------
# Delivery: AI "Suggested opening line" column (client file: opening_line.ai: true,
#   capped by opening_line.max_cost_usd). Outbound: AI email writer + AI reply sorting.
ANTHROPIC_API_KEY=                  # writer.provider: anthropic (claude-haiku-4-5 is the cheapest)
OPENAI_API_KEY=                     # writer.provider: openai (only ever sent to api.openai.com)
# For writer.provider: openai_compatible (OpenRouter, Groq, a local server, ...) set
# writer.api_key_env in the playbook to the name of the variable holding that key, e.g.:
# OPENROUTER_API_KEY=

# --- Google Sheets (optional; pip install -e ".[sheets]") -------------------------------
# Delivery: a client file's delivery.google_sheet push. Also the gsheets review exporter.
GOOGLE_APPLICATION_CREDENTIALS=     # path to a service-account JSON key file ...
GOOGLE_SERVICE_ACCOUNT_JSON=        # ... or the JSON itself on one line
# Share the sheet with the service account's email address.

# --- Alerts (optional, both modes) ------------------------------------------------------
SLACK_WEBHOOK_URL=                  # slack notifier: Slack "incoming webhook" URL (run summaries, alerts)
LEADGEN_WEBHOOK_URL=                # webhook notifier: POST run summaries / alerts to any URL

# =============================================================================
#  OUTBOUND MODE ONLY (mode: outbound, e.g. playbooks/my-agency.yaml) - finding
#  clients for your own business. Not needed for delivering reports.
# =============================================================================

# --- You, in cold emails (${SENDER_TITLE} etc. in the outbound playbooks) ---------------
SENDER_TITLE=Founder
SENDER_COMPANY=Your Company
BOOKING_LINK=                       # Calendly / Cal.com link for interested replies

# --- Sending tools ----------------------------------------------------------------------
INSTANTLY_API_KEY=                  # instantly exporter (push leads into a campaign)
INSTANTLY_CAMPAIGN_ID=              # used as ${INSTANTLY_CAMPAIGN_ID} in the playbooks
SMARTLEAD_API_KEY=                  # smartlead exporter
SMARTLEAD_CAMPAIGN_ID=              # used as ${SMARTLEAD_CAMPAIGN_ID} in the playbooks
LEADGEN_EXPORT_WEBHOOK_URL=         # webhook exporter: POST handed-over leads to Zapier / Make / n8n / a CRM
# instantly_csv / smartlead_csv upload files need no key.

# --- Reply webhook server (leadgen serve) -----------------------------------------------
LEADGEN_WEBHOOK_TOKEN=              # shared secret; Instantly/Smartlead call .../webhook?token=<this>

# =============================================================================
#  ADVANCED
# =============================================================================
LEADGEN_PLUGINS=                    # comma-separated Python modules that add your own adapter types, e.g. my_adapters
